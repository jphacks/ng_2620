{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの権限。接続先 URL はユーザー設定なので HTTP は広く許可する（P1 でプロファイル登録時に絞る、ADR-0012）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "http://*/*" },
        { "url": "http://*:*" },
        { "url": "http://*:*/*" },
        { "url": "https://*" },
        { "url": "https://*/*" },
        { "url": "https://*:*" },
        { "url": "https://*:*/*" }
      ]
    }
  ]
}
