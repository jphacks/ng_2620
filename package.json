{
  "name": "vvlog",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @vvlog/desktop dev",
    "dev:web": "pnpm --filter @vvlog/desktop dev",
    "dev:web:app": "node scripts/dev-web-app.mjs",
    "dev:web:app:fresh": "node scripts/dev-web-app.mjs --fresh",
    "dev:web:app:dist": "node scripts/dev-web-app.mjs --dist",
    "build": "pnpm --filter @vvlog/desktop build",
    "test": "pnpm --filter @vvlog/desktop test",
    "lint": "pnpm --filter @vvlog/desktop lint",
    "typecheck": "pnpm --filter @vvlog/desktop typecheck",
    "mock": "sh services/mock_server/run.sh --port 8766",
    "mock:win": "powershell -ExecutionPolicy Bypass -File services/mock_server/run.ps1 --port 8766",
    "format": "prettier --write apps/desktop",
    "format:check": "prettier --check apps/desktop"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10"
  }
}
